{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "rig",
      "displayName": "HEM Rig \u2014 i7-14700HX / MSVC x64",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/rig",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "rig-asio",
      "displayName": "HEM Rig \u2014 ASIO SDK required",
      "inherits": "rig",
      "binaryDir": "${sourceDir}/build/rig-asio",
      "cacheVariables": {
        "HC_REQUIRE_ASIO_SDK": "ON"
      }
    },
    {
      "name": "rig-full",
      "displayName": "HEM Rig \u2014 ASIO + VST3 (release build)",
      "inherits": "rig",
      "binaryDir": "${sourceDir}/build/rig-full",
      "cacheVariables": {
        "HC_REQUIRE_ASIO_SDK": "ON",
        "HC_BUILD_VST3": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "rig-debug",
      "configurePreset": "rig",
      "configuration": "Debug"
    },
    {
      "name": "rig-release",
      "configurePreset": "rig",
      "configuration": "Release"
    },
    {
      "name": "rig-asio-release",
      "configurePreset": "rig-asio",
      "configuration": "Release"
    },
    {
      "name": "rig-full-release",
      "configurePreset": "rig-full",
      "configuration": "Release"
    }
  ]
}
