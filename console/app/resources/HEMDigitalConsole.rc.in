// Generated by CMake from HEMDigitalConsole.rc.in — version comes from console/VERSION.
#include <winver.h>

1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/HEMDigitalConsole.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @HEM_CONSOLE_V1@,@HEM_CONSOLE_V2@,@HEM_CONSOLE_V3@,0
 PRODUCTVERSION @HEM_CONSOLE_V1@,@HEM_CONSOLE_V2@,@HEM_CONSOLE_V3@,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Hybrid Elite Mafia"
            VALUE "FileDescription",  "HEM Digital Console"
            VALUE "FileVersion",      "@HEM_CONSOLE_VERSION@"
            VALUE "ProductName",      "HEM Digital Console"
            VALUE "ProductVersion",   "@HEM_CONSOLE_VERSION@"
            VALUE "LegalCopyright",   "Hybrid Elite Mafia"
            VALUE "OriginalFilename", "HEMDigitalConsole.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
