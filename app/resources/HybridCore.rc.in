// Generated by CMake from HybridCore.rc.in — version comes from the VERSION file.
#include <winver.h>

1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/HybridCore.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Hybrid Elite Mafia"
            VALUE "FileDescription",  "The Hybrid Core"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "ProductName",      "The Hybrid Core"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
            VALUE "LegalCopyright",   "Hybrid Elite Mafia"
            VALUE "OriginalFilename", "HybridCore.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
